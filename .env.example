# Gemini — use Vertex (GCP credits) in production.
# AI Studio key is only fallback if GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_GENAI_USE_VERTEXAI=true
GEMMA_MODEL=gemma-3-12b-it
VEO_MODEL=veo-3.0-generate-preview
LYRIA_MODEL=lyria-002

# Google Cloud
GOOGLE_CLOUD_PROJECT=gen-lang-client-0614591307
GOOGLE_CLOUD_LOCATION=global
GCS_BUCKET=
HUB_USE_FIRESTORE=false
ENABLE_WORKSPACE_MCP=false

# Telegram — paste the token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: Groq is not part of the hackathon stack
# GROQ_API_KEY=
